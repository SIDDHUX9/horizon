# Copy to .env for local development only. Never commit real keys.

# Browser runtime mode. Leave false/unset in production: circuit calls require a
# verified deployment. Set true only for an explicitly labelled local demo build.
VITE_DEMO_MODE=false

# Optional local/provider configuration used by scripts and the Vite dev middleware.
MIDNIGHT_NETWORK=preview
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
MIDNIGHT_INDEXER=https://preview-service-v2-01.midnightexplorer.com/api/v1

# Public REST indexer used by the browser for chain reads. The wallet's own
# indexer configuration remains authoritative for contract calls.
VITE_INDEXER_URL=https://preview-service-v2-01.midnightexplorer.com/api/v1

# For production deployment verification, use the authenticated official
# indexer. These are server-side only; never expose them through VITE_ variables.
# MIDNIGHT_INDEXER_GRAPHQL=https://midnight-preview.blockfrost.io/api/v0
# MIDNIGHT_INDEXER_PROJECT_ID=

# Do not set the following in a browser-exposed VITE_ variable. They belong only
# in a server-side deployment environment and must be rotated if ever exposed.
# MIDNIGHT_COIN_KEY=
# MIDNIGHT_ENCRYPTION_KEY=
