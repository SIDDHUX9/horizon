# Horizon Protocol - Environment Variables Template
# Copy this file to .env and insert your private keys for deployment.
# WARNING: NEVER commit your actual .env file to version control.

# Midnight Network Shielded Keys (Used strictly by Node deployment scripts)
# DO NOT prefix these with VITE_ to prevent client-side bundle leakage.
MIDNIGHT_COIN_KEY=""
MIDNIGHT_ENCRYPTION_KEY=""

# Midnight Network Configuration
MIDNIGHT_NETWORK="preview"
MIDNIGHT_INDEXER="https://preview-service-v2-01.midnightexplorer.com/api/v1"
MIDNIGHT_PROOF_SERVER="http://127.0.0.1:6300"
