{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%borrower.0", "type": "Scalar<BLS12-381>" },
    { "name": "%borrower.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>",
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%borrower.0", "bits": 8 },
    { "op": "constrain_bits", "val": "%borrower.1", "bits": 248 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%snapshot.2", "guard": null },
    { "op": "constrain_bits", "val": "%snapshot.2", "bits": 64 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%snapshot.3", "guard": null },
    { "op": "constrain_bits", "val": "%snapshot.3", "bits": 64 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%snapshot.4", "guard": null },
    { "op": "constrain_bits", "val": "%snapshot.4", "bits": 32 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%snapshot.5", "guard": null },
    { "op": "constrain_bits", "val": "%snapshot.5", "bits": 32 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%snapshot.6", "guard": null },
    { "op": "constrain_bits", "val": "%snapshot.6", "bits": 8 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%snapshot.7", "guard": null },
    { "op": "constrain_bits", "val": "%snapshot.7", "bits": 248 },
    { "op": "less_than", "output": "%t.8", "a": "0x00", "b": "%snapshot.2", "bits": 64 },
    { "op": "assert", "cond": "%t.8" },
    { "op": "persistent_hash", "output": "%bytes.9", "alignment": [{ "tag": "atom", "value": { "length": 8, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 8, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 4, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 4, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%snapshot.2", "%snapshot.3", "%snapshot.4", "%snapshot.5", "%snapshot.6", "%snapshot.7"] },
    { "op": "bytes_into_natives", "outputs": ["%commitment.10", "%commitment.11"], "bytes": "%bytes.9" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x70", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x20", "%borrower.0", "%borrower.1"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x20", "%commitment.11", "%commitment.10"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0xa1"] },
    { "op": "output", "vals": ["%commitment.11", "%commitment.10"] }
  ]
}
