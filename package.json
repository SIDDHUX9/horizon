{
  "name": "horizon-protocol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile:compact": "node scripts/compile-compact.js",
    "preflight:proof": "node scripts/preflight-proof-server.js",
    "preflight:deploy": "node scripts/deploy-midnight.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "confirm:deployment": "node scripts/confirm-deployment.js",
    "verify:artifacts": "node scripts/verify-artifacts.js",
    "verify:build": "node scripts/verify-build-artifacts.js",
    "check:release": "node scripts/check-release-gate.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "ci": "npm run typecheck && npm run verify:artifacts && npm test && npm run build && npm run verify:build && npm run check:release"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/dapp-connector-api": "4.1.0",
    "@midnight-ntwrk/midnight-js": "5.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/wallet-sdk-prover-client": "2.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "level": "10.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnight-ntwrk/platform-js": "3.0.0"
  }
}
